# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file (it is already excluded via .gitignore).

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=immodigger
POSTGRES_USER=immodigger
POSTGRES_PASSWORD=
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=immodigger;Username=immodigger;Password=

# --- Environnement Docker de test --------------------------------------
DEMO_MODE=true
API_PORT=5080
FRONTEND_PORT=5173
COLLECTION_INTERVAL_MINUTES=15
COLLECTION_SCHEDULE_ENABLED=false

# --- Accès (obligatoire en production) ---------------------------------
# Comptes séparés par des virgules, au format nom:motdepasse.
# APP_USERS : accès complet. APP_READONLY_USERS : consultation seule.
APP_USERS=
APP_READONLY_USERS=
# Nom de domaine servi en HTTPS par compose.prod.yaml.
DOMAIN=

# --- Import des alertes email (optionnel, IMAP) ------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_LOOKBACK_DAYS=7
IMAP_MAX_MESSAGES_PER_RUN=250
# false est plus fiable : le Message-ID en base assure l'idempotence.
IMAP_UNSEEN_ONLY=false
# Active automatiquement la source EmailImport quand les identifiants sont complets.
IMAP_AUTO_ENABLE=true

# --- Telegram notifications ---------------------------------------------
# Create a bot via @BotFather, then get your chat id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email notifications (optional) -------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Frontend -------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5080/api
