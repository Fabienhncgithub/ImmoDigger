# Site block to import into an existing Caddy proxy that shares a Docker
# network with the frontend container (compose.shared-proxy.yaml).
{$IMMODIGGER_DOMAIN:immodigger.example.com} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy immodigger-web:80
}
